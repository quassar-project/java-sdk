dsl metta

Concept Command as component
	sub CollectionCommand
		sub Grouping
			def string label

Concept View
	facet Inherited
		def string label
	facet ViewType
		sub Projection
			Concept:Single Commands
				has:Single Grouping
			Concept Panel
				def Projection target

Concept Widget
	def View.Projection view

Concept Dashboard
	facet Inherited
		def string caption
	facet Display
		sub Projection

Concept Preview
	def Dashboard.Projection view
