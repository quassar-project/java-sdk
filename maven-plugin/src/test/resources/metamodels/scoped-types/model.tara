dsl metta

Concept Command as component
	def boolean enabled
	sub CollectionCommand
		sub Grouping
			def string label

Concept Toolbar
	has Command

Concept View
	facet Inherited
		def string label
	facet Alternate
		sub Shared
	facet ViewType
		sub Shared
		sub Reference
		sub Projection
			Concept:Single Commands
				has:Single Grouping
			Concept Panel
				def Projection target
			sub Container
				def string composition

Concept Widget
	def View.Projection view

Concept Dashboard
	facet Inherited
		def string caption
	facet Display
		sub Projection

Concept Preview
	def Dashboard.Projection view
