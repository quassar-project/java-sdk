dsl metta

Concept:MustHaveAtLeastTwoParties:StartDateEarlierThanEndDate Contract
	def string id
	def date startDate
	def date endDate
	has:Required:MutuallyExclusiveObligations Clause
	def Party[] parties

Concept Party
	def string name
	def word:{Buyer Seller Lessor Lessee Provider Client} role
	def string identifier

Concept:LeafClauseHasObligation:MutuallyExclusiveObligations Clause as component
	def string title
	def string description
	has:MutuallyExclusiveObligations Clause
	Concept:HasAbsoluteXorRelativeDeadline Obligation
		def string description
		def Party actor
		def word:{Pay Deliver Notify Transfer Terminate Renew} action
		def date deadline = empty
		def integer relativeDeadlineInDays = empty

	Concept:Single Penalty
		def double amount
		def string description

	/* Change 3. A clause can be defined as recurring, indicating that it applies periodically over time. */
	/* In that case, a cadence in months must be specified to determine the interval between */
	/* successive repetitions. */
	Concept Recurring
		def integer cadence

	facet Conditional
		Concept:Single:Required Condition
			def word:{Event Date State} type
			def string expression

constraint MutuallyExclusiveObligations :: not (count(all(Obligation, o -> o.action == "Terminate")) >=1 and count(all(Obligation, o -> o.action == "Renew")) >=1)
	"Cannot coexists inside a cluse and oblgation action of 'Terminate' and 'Renovate'"

constraint LeafClauseHasObligation :: count(Clause) > 0 or count(Obligation) >= 1
	"A clause without subclauses must declare at least one Obligation"

/* Change 1. Contracts must have at least two parties. */
constraint MustHaveAtLeastTwoParties :: count(parties) >= 2
	"Contracts must have at least two parties."

/* Change 2. The start date must be earlier than the end date. */
constraint StartDateEarlierThanEndDate :: startDate < endDate
	"The start date must be earlier than the end date."

/* Change 3. Continued */
constraint HasAbsoluteXorRelativeDeadline :: (deadline is empty and relativeDeadlineInDays is not empty) or (relativeDeadlineInDays is empty and deadline is not empty)  
	"The obligation has either an absolute or a relative deadline"