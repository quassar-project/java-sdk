dsl metta

constraint RequiresAspect :: self is not empty
    message = "An aspect must be selected for this element."

constraint CheckPath :: path is not empty and path starts with "/"
    message = "The path must start with '/'."

constraint CheckFileParameter :: count(all(components(), p -> p is "File" and p.location != "form")) == 0
    message = "File parameters must use form location."