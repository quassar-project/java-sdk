				def string valor
				def word:{Query Header Form} tipo = Query

		facet CAT
			def string registro
			def string codificacion = "Windows-1252"

		Concept:Single Filtro
			facet Y > has:{2..*} Filtro
			facet O > has:{2..*} Filtro
			facet No > has:Single Filtro
			facet Igual > def string campo; def string valor
			facet Distinto > def string campo; def string valor
			facet En > def string campo; def string[] valores
			facet NoEn > def string campo; def string[] valores
			facet Presente > def string campo
			facet Ausente > def string campo
			facet Mayor > def string campo; def string valor
			facet MayorIgual > def string campo; def string valor
			facet Menor > def string campo; def string valor
			facet MenorIgual > def string campo; def string valor

	Concept:Single Importacion

		Concept:Single Identidad
			def string[] campos

			Concept Alternativa
				def string[] campos

		Concept Marca
			def Atributo atributo
			def Transformacion transformacion = empty

			facet Origen
				sub Campo
					def string nombre
				sub Constante
					def string valor
				sub Expresion
