dsl metta


Concept Nota as component
	def string nota
	

Concept Atributo as component
	def string descripcion = empty
	facet Tipo
		sub Booleano
		sub Texto
		sub Numero
			def string metrica = empty
		sub Fecha
			def word:{Año Mes Dia Hora Minuto Segundo} resolucion = empty
		sub Enlace
			def Entidad entidad
			def Faceta faceta = empty
		sub Termino
			def Tesauro tesauro
		sub Tupla
			has Atributo
	facet Mutable
	facet Multiple
	facet Compuesto
		has Atributo
	facet DatoPersonal
		def word:{IdentificacionBasica Contacto IdentificacionDigital Demograficos Profesionales EconomicosYFinancieros Transaccionales Localizacion Comportamiento Comunicaciones Audiovisuales FamiliaresYSociales Salud Biometricos Geneticos Educativos JudicialesYAdministrativos RecursosHumanos} tipo
	facet Clasificador

Concept Faceta as component
	facet Mutable
	facet TipoFaceta
		sub Especializacion
		sub Extension
	def string nombre = empty
	def string descripcion = empty
	def string nombreColeccion = empty
	has Faceta
	has Atributo
	has Tesauro
	has Nota
	Concept Ejemplo
		def string descripcion



Concept Label
	def string token
	def string label



Concept Dataset as component
	def string nombre
	def word:{Baja Media Alta Critica} criticidad = Critica
	def string descripcion = empty
	def boolean operativa = true
	has Nota

	Concept Incompatibilidad
		def string codigo
		def string campo
		def string descripcion
		def string recomendacion

	facet Estructural
