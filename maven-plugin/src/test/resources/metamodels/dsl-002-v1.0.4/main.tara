dsl metta

Concept:StartDateEarlierEndDate:MinTwoParties Contract
	def string id
	def date startDate
	def date endDate
	has:Required:MutuallyExclusiveObligations Clause
	def Party[] parties

Concept Party
	def string name
	def word:{Buyer Seller Lessor Lessee Provider Client} role
	def string identifier

Concept:LeafClauseHasObligation:MutuallyExclusiveObligations Clause as component
	def string title
	def string description
	has:MutuallyExclusiveObligations Clause
	Concept Obligation
		def string description
		def Party actor
		def word:{Pay Deliver Notify Transfer Terminate Renew} action
		def date deadline
	Concept:Single Penalty
		def double amount
		def string description
	Concept Recurring
		def date recurring_date
		
	facet Conditional
		Concept:Single:Required Condition
			def word:{Event Date State} type
			def string expression

	facet Recurrent
		Concept Recurrency
			def integer stepDays
			def date startDate
		
constraint StartDateEarlierEndDate :: startDate < endDate
	"The start date must be earlier than the end date."

constraint MinTwoParties :: count(parties) > 1
	"Contracts must have at least two parties."

constraint MutuallyExclusiveObligations :: not (count(all(Obligation, o -> o.action == "Terminate")) >=1 and count(all(Obligation, o -> o.action == "Renew")) >=1)
	"Cannot coexists inside a cluse and oblgation action of 'Terminate' and 'Renovate'"

constraint LeafClauseHasObligation :: count(Clause) > 0 or count(Obligation) >= 1
	"A clause without subclauses must declare at least one Obligation"
