dsl Metta

Concept:Single Unit
	def Module main = empty
	
	has:Single:Required Label
	has Subject

Concept Context as component

	sub Pin
		has:Single:Required Label
		Concept:{1..1} Content
			sub Singleton
				def string id
			sub Query
				def string type
				def string condition = empty

	sub Subject
		def string type
		Concept:Single Access
			def string[] roles
			Concept:Single Edition > def string[] roles
			Concept:Single Signing > def string[] roles


Concept Module
	has:Single:Required Label
	has Subject
	has Pin

Concept Operation
	def Context[] contexts
	def string dialog = empty

	has:Single:Required Label
	Concept:Single Hint > def string message

	Concept:Single Acccess > def string[] roles

	Concept:Single Availability

		sub TagAvailability
			Concept:Single:Required When
				def string tag
				def string value

			sub Visible
			sub Hidden

		sub ComplianceAvailability
			def string compliance = empty

			sub HiddenIfNotCompliant
			sub DisabledIfNotCompliant

	facet Type
		sub WorkflowTrigger
			def Workflow workflow

		sub FileDelivering
			def string[] options = empty

	facet NonBlocking
	
	facet OneShot
		def string id

	facet PermissionBased
		def string message
		def word:{Simple Tokenized} type = Simple

Concept Workflow

	Concept Stop
		has:Single:Required Label
		def string compliance = empty

		Concept:Single Hint > def string message

		sub:Single:Required Departure
			def Stop stop

		sub WayPoint
			Concept:Single:Required Next
				def Stop stop

		sub Cross
			Concept:Required Exit
				has:Single:Required Label
				def Stop stop

		sub:Single:Required Arrival

Concept Label as component
	def string value
	def resource icon = empty




