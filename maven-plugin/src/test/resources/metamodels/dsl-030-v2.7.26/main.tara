dsl Metta

Concept:Single Unit
	def Module main = empty

	has:Single:Required Label
	has:Single Logo
	has:Single Icon

	has Role
	has Subject

Concept Role as component
	def string type

Concept Context as component

	sub Pin
		has:Single:Required Label
		has:Single Icon

		Concept:Single Access > def Role[] roles

		facet SubjectPanel
			Concept:Single:Required Content
				sub Singleton
					def string id
				sub Query
					def Subject subject = empty
					def string condition = empty
					
		facet ErrorPanel
		facet SearchPanel
		facet TaskPanel
		facet RolePanel

	sub Subject	
		def string type
		def boolean allowComments = false

		Concept:Single Access
			def Role[] roles = empty
			Concept:Single Edition > def Role[] roles
			Concept:Single Signing > def Role[] roles

	facet Locked	

Concept Module

	has:Single:Required Label
	has Pin

	Concept:Single Access > def Role[] roles

	facet Locked	

Concept Group
	def string name
	has:{1..*} Operation

Concept Operation
	def Context[] contexts
	def integer priority = -1
	def boolean highlighted = false
	def string color = empty
	def word:{Header Sidebar} location = Sidebar

	has:Single:Required Label
	has:Single Hint
	has:Single Dialog

	Concept:Single Access > def Role[] roles
	
	has Availability

	facet Type
		sub WorkflowTrigger
			def Workflow workflow

		sub FileDelivering
			def string[] options = empty

	facet NonBlocking
	
	facet OneShot
		def string id

	facet PermissionBased
		def string message
		def word:{Simple Tokenized} type = Simple

Concept Workflow

	Concept Stop
		has:Single:Required Label
		has:Single Hint
		def integer priority = -1
		def boolean highlighted = false
		def string color = empty
		
		Concept:Single Access > def Role[] roles
		has Availability

		sub:Single:Required Departure
			def Stop stop

		sub WayPoint
			Concept:Single:Required Next
				def Stop stop

		sub Cross
			Concept:Required Exit
				def Stop stop

				has:Single:Required Label
				has:Single Hint
				
		sub:Single:Required Arrival

Concept Label as component > def string value
Concept Hint as component > def string value
Concept Logo as component > def resource value
Concept Icon as component > def resource value

Concept Availability as component

	sub TagAvailability
		def string messageIfNotAvailable = empty

		has Condition

		sub Visible
		sub Hidden
		sub Enabled
		sub Disabled

	sub ComplianceAvailability
		def string compliance = empty

		sub HiddenIfNotCompliant
		sub DisabledIfNotCompliant

Concept Condition as component

	sub TagCondition
		def string tag

		sub TagValueCondition
			def string[] value

			sub IfEquals
			sub IfNotEquals

		sub UserCondition
			def word:{This Parent GrandParent} context = This

			sub IfUser
			sub IfNotUser

	sub And > has TagCondition
	sub Or > has TagCondition

Concept Dialog as component
	def Subject subject
	def string view
