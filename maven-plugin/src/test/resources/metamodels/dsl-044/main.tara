dsl metta

Concept ContratoInteligente
	def string identificador
	Concept:ControlFechas Vigencia
		def instant fechainicio
		def instant fechafin
	def ParteContratante[] partes
	Concept Clausulas 
		Concept:{1..*} Clausula
			def string titulo
			def string descripcion
			facet tipo
				def boolean condicionada = false
				def boolean recurrente = false
			def integer:{meses} periodicidadaplicacion
			def string condicionactivacion
			def instant fechaactivacion
			Concept Obligaciones
				Concept Obligacion
					def ParteContratante parteobligada
					def word:{Pay Deliver Notify Transfer Terminate Renew} accion = empty
					def instant fechalimitecumplimiento
					facet Penalizacion
						def double:{€} cantidadeconomica
						def string descripcion
			def Clausula[] subclausulas 				

Concept ParteContratante 
	def string nombre
	def string numerodocumento
	def word:{Buyer Seller Lesser Lessee Provider Client} rol = empty
	
constraint ControlNumeroPartes :: count(partes) >= 2
	message = "Un contrato debe tener al menos dos partes"
 
constraint ControlFechas:: fechainicio < fechafin
	message = "La fecha de finalización debe ser posterior a la fecha de inicio."

constraint ControlAcciones1 :: count(all(Obligacion, o -> o.accion == "Renew")) > 0 and count(all(Obligacion, o -> o.accion == "Terminate")) < 1
	message = "No se permite que una cláusula contenga simultáneamente acciones incompatibles"

constraint ControlAcciones2 :: count(all(Obligacion, o -> o.accion == "Renew")) < 1 and count(all(Obligacion, o -> o.accion == "Terminate")) > 0
	message = "No se permite que una cláusula contenga simultáneamente acciones incompatibles"

constraint ControlCadencia :: periodicidadaplicacion is not empty and recurrente is true
	message = "Toda cláusula recurrente debe especificar una cadencia válida"