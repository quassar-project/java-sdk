Concept Contrato
	def long id
	def date fecha-inicio
	def date fecha-finalización
	has:{2..*} Parte
	has:{0..*} Cláusula


Concept Parte
	def long id
	def string name
	def word:{Buyer Seller Lessor Lessee Provider Client} rol

Concept Cláusula
