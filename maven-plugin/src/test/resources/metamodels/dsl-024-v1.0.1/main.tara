dsl metta


// ==============================
// TESAUROS. DATOS REFERENCIALES
// ==============================
// Catálogo jerárquico de términos utilizado para clasificar, tipificar o normalizar conceptos del dominio.

Concept Tesauro
	def string nombre
	def string descripcion
	Concept Termino
		def string nombre
		def string descripcion = empty
		has Termino
	has Nota	

// ==============================
// ENTIDADES. DATOS MAESTROS
// ==============================
// Las entidades describen objetos, personas, lugares, activos o conceptos identificables y relativamente estables.

Concept Entidad
	def string descripcion
	has Atributo
	has Faceta
	has Tesauro
	has Nota


// ==============================
// EVENTOS. DATOS TRANSACCIONALES
// ==============================
// Representación de hechos, cambios, observaciones o actuaciones que ocurren sobre entidades, personas, activos o el territorio.

Concept Evento
	def string descripcion
	has Atributo
	has Faceta
	has Tesauro
	has Nota
	

// ==============================
// INDICADORES. DATOS ANALITICOS
// ==============================

Concept Indicador as component
	def string nombre
	def string descripcion = empty
	def string codigo = empty
	def Eje eje
	def Objetivo[] objetivos
	Concept Filtro
		def string formula
		def string descripcion = empty
	Concept:Required Calculo
		def string formula
	Concept Dimension
		def string nombre
		def string descripcion = empty
		def string codigo = empty
		facet Naturaleza
			sub Temporal
				def word:{Año AñoMes AñoMesDia Mes Dia} resolucion
			sub Referencial
				def Tesauro tesauro
			sub Maestra
				def Entidad entidad
				def Faceta faceta = empty
			sub Binario
			sub Discretizada
				def integer[] cortes
		Concept Segmentacion
			def string nombre
			def string descripcion
			def string codigo = empty
			facet Naturaleza
				sub Especifico
					def string valor


// ==============================
// EJES ESTRATEGICOS
// ==============================
Concept Eje
	def string nombre = empty
	def string descripcion
	has Nota

Concept Objetivo
	def string descripcion
	has Objetivo
	has Nota




Concept Coleccion	
	Concept Filtro
		def string descripcion
	facet Estructural
		def Entidad entidad
		def Faceta faceta = empty
	facet Transaccional
		def Evento evento
		def Faceta faceta = empty
	has Indicador




// ==============================
// FUENTES
// ==============================
// Origen de información utilizado para alimentar eventos, entidades, métricas o análisis.


Concept Fuente
	def string descripcion = empty
	has Nota

	Concept Soporte
		def string descripcion = empty
		has Nota

		Concept Vista
			def word:{SQL} tipo
			def string descripcion = empty
			has Nota

			Concept consulta
				def string descripcion = empty
				has Nota
				
			facet Estructural
				def Entidad entidad
				def Faceta faceta = empty
			facet Transaccional
				def Evento evento
				def Faceta faceta = empty

			Concept Extension
				def Faceta faceta
			Concept Marca
				def Atributo atributo
				def string[] campos
				Concept Transformacion
					def string funcion
				Concept Inferencia
					def string funcion
					def Vista vista
