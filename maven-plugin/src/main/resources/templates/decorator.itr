rule type(decorator)
	final class NodeSupport {
		private NodeSupport() {
		}

		private static final io.quassar.reader.model.NodeTypeHierarchy HIERARCHY = new io.quassar.reader.model.NodeTypeHierarchy(java.util.List.of($hierarchy~));

		private static final java.util.Map<java.lang.Class<? extends io.quassar.reader.model.Node>, AncestorView> ANCESTORS =
			java.util.Map.ofEntries($ancestors~);

		private record AncestorView(java.lang.String name, java.util.function.BiFunction<$mogramType~, $modelType~, io.quassar.reader.model.Node> wrap) {
		}

		static <T extends io.quassar.reader.model.Node> T ancestorView(java.lang.Class<T> type, $mogramType~ ancestor, $modelType~ model) {
			if (type.equals(io.quassar.reader.model.Node.class)) return type.cast(of(ancestor, model));
			var view = ANCESTORS.get(type);
			if (view == null) throw new java.lang.IllegalArgumentException("Unknown node type: " + type.getName());
			var match = !ancestor.isNull() && types(ancestor, model, view.name()).contains(view.name());
			return type.cast(view.wrap().apply(match ? ancestor : $mogramType~.NULL, model));
		}

		static java.util.List<java.lang.String> types($mogramType~ mogram, $modelType~ model, java.lang.String declared) {
			return HIERARCHY.types(MogramTypes.resolve(mogram, model), declared, mogram.facets());
		}

		static io.quassar.templating.ports.FrameView frame($mogramType~ mogram, $modelType~ model, java.util.List<java.lang.String> types) {
			return new MogramFrame(mogram, model, types);
		}

		static java.util.List<io.quassar.templating.ports.FrameView.Slot> groupSlots(java.util.List<$mogramType~> members, $modelType~ model) {
			var groups = new java.util.LinkedHashMap<java.lang.String, java.util.List<io.quassar.reader.model.Node>>();
			for (var member : members) {
				var name = member.type().substring(member.type().lastIndexOf('.') + 1).toLowerCase(java.util.Locale.ROOT);
				groups.computeIfAbsent(name, key -> new java.util.ArrayList<>())
					.add(of(member, model));
			}
			java.util.List<io.quassar.templating.ports.FrameView.Slot> slots = new java.util.ArrayList<>();
			groups.forEach((name, group) -> slots.add(new io.quassar.templating.ports.FrameView.ValueSlot(name, java.util.List.copyOf(group))));
			return java.util.List.copyOf(slots);
		}

		static java.util.List<$valueType~> values($valueType~ value) {
			if (value.isSequence()) return value.asSequence();
			return value.isEmpty() ? java.util.List.of() : java.util.List.of(value);
		}

		static java.lang.String word($valueType~ value) {
			if (value instanceof $valueType~.Number number) return number.value().toPlainString();
			if (value instanceof $valueType~.Bool bool) return java.lang.Boolean.toString(bool.value());
			return value.isReference() ? value.asReference() : value.asString();
		}

		static io.quassar.reader.model.Node of($mogramType~ mogram, $modelType~ model) {
			return switch (MogramTypes.resolve(mogram, model)) {
	$cases~			default -> new NullObject(model);
			};
		}

		private static final class NullObject extends io.quassar.reader.model.Node {
			private NullObject($modelType~ model) {
				super($mogramType~.NULL, model);
			}

			@Override
			protected io.quassar.templating.ports.FrameView frameView() {
				return frame(mogram, model, types());
			}

			@Override
			protected <T extends io.quassar.reader.model.Node> T ancestorView(java.lang.Class<T> type, $mogramType~ ancestor) {
				return NodeSupport.ancestorView(type, ancestor, model);
			}
		}

		private record MogramFrame($mogramType~ mogram, $modelType~ model, java.util.List<java.lang.String> types) implements io.quassar.templating.ports.FrameView {
			public java.lang.Object frameIdentity() {
				return mogram.isNull() ? null : mogram;
			}

			public io.quassar.reader.model.Node frameParent() {
				return of(model.parentOf(mogram), model);
			}

			public java.util.List<java.lang.String> frameTypes() {
				var names = new java.util.LinkedHashSet<java.lang.String>();
				names.add(mogram.type());
				names.add(MogramTypes.resolve(mogram, model));
				names.addAll(mogram.facets());
				for (var type : types) {
					names.add(type);
					names.add(type.substring(type.lastIndexOf('.') + 1));
				}
				return java.util.List.copyOf(names);
			}

			public java.util.List<Slot> frameSlots() {
				var properties = new java.util.LinkedHashMap<java.lang.String, Slot>();
				properties.put("identifier", new ValueSlot("identifier", mogram.identifier()));
				int position = 0;
				for (var property : mogram.properties()) {
					java.lang.String name = property.name() == null ? "value" + ++position : property.name();
					name = name.toLowerCase(java.util.Locale.ROOT);
					properties.put(name, new ValueSlot(name, frameValues(property.value())));
				}
				java.util.List<Slot> slots = new java.util.ArrayList<>(properties.values());
				slots.addAll(groupSlots(mogram.children(), model));
				return java.util.List.copyOf(slots);
			}

			private java.util.List<java.lang.Object> frameValues($valueType~ value) {
				if (value.isSequence()) return value.asSequence().stream().flatMap(item -> frameValues(item).stream()).toList();
				if (value.isString()) return java.util.List.of(value.asString());
				if (value.isNumber()) return java.util.List.of(value.asNumber());
				if (value.isBoolean()) return java.util.List.of(value.asBoolean());
				if (value.isReference()) return java.util.List.of(of(model.get(value, mogram), model));
				return java.util.List.of();
			}
		}

	$types~}$NL
