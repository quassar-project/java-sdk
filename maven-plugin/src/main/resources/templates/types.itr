rule type(types)
		static final class MogramTypes {
			private MogramTypes() {
			}

			static java.lang.String resolve($mogramType~ mogram, $modelType~ model) {
				java.lang.String type = mogram.type();
				if (mogram.isNull() || type.indexOf('.') >= 0) return type;
				$mogramType~ parent = model.parentOf(mogram);
				if (parent.isNull()) return type;
				return resolve(type, resolve(parent, model));
			}

			static java.lang.String resolve(java.lang.String type, java.lang.String parentType) {
				if (type.indexOf('.') >= 0) return type;
				return switch (parentType + "." + type) {
		$aliases~				default -> type;
				};
			}

			static boolean matches(java.lang.String actual, java.lang.String expected) {
				if (actual.equals(expected)) return true;
				return switch (expected) {
		$subtypes~				default -> false;
				};
			}
		}$NL
